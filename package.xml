<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tartan_to_ros</name>
  <version>0.0.0</version>
  <description>Publishes TartanAir dataset (RGB, depth, LiDAR) as ROS 2 topics</description>
  <maintainer email="0619966850@uma.es">israelnunez</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- ROS 2 message / interface packages -->
  <depend>rclpy</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- Python libraries -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>ros-humble-cv-bridge</exec_depend>
  <exec_depend>python3-open3d</exec_depend>

  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
