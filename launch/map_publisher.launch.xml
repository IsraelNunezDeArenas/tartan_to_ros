<?xml version="1.0"?>
<launch>

  <!-- =========================================================== -->
  <!--  ARGUMENTOS GLOBALES (sobreescribibles desde línea de comandos) -->
  <!-- =========================================================== -->

  <!-- Dataset -->
  <arg name="dataset_path"
       default="/home/israelnunez/tartanairpy/AbandonedCable/Data_omni/P0000"
       description="Ruta raíz del dataset TartanGround"/>

  <!-- Mapa PCD -->
  <arg name="pcd_path"
       default="/home/israelnunez/tartanairpy/AbandonedCable/AbandonedCable_rgb.pcd"
       description="Ruta al fichero PCD del mapa 3D"/>


  <!-- Intrínsecas de cámara — dejar camera_info_yaml vacío para usar fx/fy/cx/cy -->
  <arg name="camera_info_yaml" default=""
       description="Ruta a YAML con intrínsecas (vacío = usar parámetros individuales)"/>

  <arg name="img_width"  default="640"/>
  <arg name="img_height" default="640"/>
  <arg name="fx"         default="320"
       description="Focal length X en píxeles (-1 = obligatorio si no hay YAML)"/>
  <arg name="fy"         default="320"/>
  <arg name="cx"         default="320"
       description="Punto principal X (-1 = obligatorio si no hay YAML)"/>
  <arg name="cy"         default="320"/>

  <!-- Tópicos Publishers-->
  <arg name="topic_rgb_image"    default="/camera/rgb"/>
  <arg name="topic_depth_image"  default="/camera/depth"/>
  <arg name="topic_camera_info"  default="/camera/camera_info"/>
  <arg name="topic_localization" default="/amcl_pose"/>
  <arg name="topic_map"          default="/map"/>

  <!-- Frames TF -->
  <arg name="map_frame_id"    default="map"/>
  <arg name="robot_frame_id"  default="base_link"/>
  <arg name="camera_frame_id" default="camera"/>
  <arg name="lidar_frame_id"  default="lidar"/>

  <!-- Publicación del dataset -->
  <arg name="publish_rate" default="10.0"
       description="Frecuencia de publicación del dataset en Hz"/>

  <!-- Mapa: conversión PCD → OccupancyGrid -->
  <arg name="map_resolution" default="0.05"
       description="Metros por celda del OccupancyGrid"/>
  <arg name="map_z_min"      default="-0.1"
       description="Altura mínima de puntos a proyectar (metros)"/>
  <arg name="map_z_max"      default="2.0"
       description="Altura máxima de puntos a proyectar (metros)"/>
  <arg name="map_padding"    default="0.5"
       description="Margen extra alrededor del mapa (metros)"/>


  <!-- =========================================================== -->
  <!--  NODO 2 — PcdMapPublisher                                   -->
  <!--  Convierte el PCD a OccupancyGrid y lo publica (latched)    -->
  <!-- =========================================================== -->
  <node pkg="tartan_to_ros"
        exec="map_tartanground.py"
        name="pcd_map_publisher"
        output="screen">

    <!-- Fichero PCD -->
    <param name="pcd_path"          value="$(var pcd_path)"/>

    <!-- Tópico y frame del mapa -->
    <param name="topic_map"         value="$(var topic_map)"/>
    <param name="map_frame_id"      value="$(var map_frame_id)"/>

    <!-- Conversión PCD → grid -->
    <param name="resolution"        value="$(var map_resolution)"/>
    <param name="z_min"             value="$(var map_z_min)"/>
    <param name="z_max"             value="$(var map_z_max)"/>
    <param name="padding"           value="$(var map_padding)"/>

  </node>

</launch>