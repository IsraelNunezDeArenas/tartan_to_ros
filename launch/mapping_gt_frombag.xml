<launch>

    <node pkg="voxeland_robot_perception" exec="robot_perception_node.py" name="voxeland_perception_node">

		<!-- Dataset Name -->
		<param name="dataset" value="" />
		<param name="object_detector" value="" />

		<!-- Topics and Services -->
		<param name="topic_camera_info" value="/rgbd/info" />
		<param name="topic_rgb_image" value="/camera/rgb" />
		<param name="topic_depth_image" value="/camera/depth" />
		<param name="topic_localization" value="/pose_gt" />

		<param name="semantic_segmentation_mode" value=""/>		# Possible values: "topic" or "service"
			<param name="service_sem_seg" value="/detectron/segment" />	# used if semantic_segmentation_mode="service"
			<param name="topic_sem_seg" value="/ViMantic/Detections" />	# used if semantic_segmentation_mode="topic"


		<!-- Images Messages Types -->
        <param name="rgb_image_type" value="Image" />     # Possible values: "CompressedImage" or "Image"
        <param name="depth_image_type" value="Image" />   # Possible values: "CompressedImage" or "Image"
		
		<!-- RGB-D Camera Info -->
		<param name="intrinsics_from_topic" value="False" />
        <param name="width"  value="640"/>
        <param name="height" value="640"/>
        <param name="fx" value="320.0"/>
        <param name="fy" value="320.0"/>
        <param name="cx" value="320.0"/>
        <param name="cy" value="320.0"/>
		<param name="camera_max_depth" value="20.0" />

		<param name="limit_reliable_depth" value="false" />
		<param name="min_reliable_depth" value="0.01" />
		<param name="max_reliable_depth" value="3.00" />

		<!-- Frame IDs -->
		<param name="map_frame_id" value="map" />
		<param name="robot_frame_id" value="base_link" />
		<param name="camera_frame_id" value="camera" />   

		<!-- Output configuration -->
		<param name="pointcloud_type" value="XYZRGB"/>					# Possible values: "XYZ", "XYZRGB" and "XYZSemantics"
		<param name="topic_pointcloud_output" value="/cloud_in" />

	</node>

    <node pkg="voxeland" exec="voxeland_server_node" name="voxeland_server">
	
		<!-- fVoxelGrid Resolution -->
		<param name="resolution" value="0.02" />

		<!-- fixed map frame (set to 'map' if SLAM or localization running!) -->
		<param name="frame_id" value="map" />

		<!-- maximum range to integrate (speedup!) -->
		<param name="sensor_model.max_range" value="4.0" />

		<!-- data source to integrate (PointCloud2) -->

		<!-- Publish Height colormap on Resulting VoxelGrid -->
		<param name="use_height_map" value="true" />

		<!-- SemanticBonxai Parameters-->
		<param name="semantics_as_instances" value="true" />

	</node>

</launch>