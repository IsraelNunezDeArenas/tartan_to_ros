<?xml version="1.0"?>
<!--
  tartanground_ekf_amcl.launch.xml
  ================================
  Pipeline completo de localización para TartanGround:

  Árbol TF:
    map ──[AMCL]──► odom ──[EKF]──► base_link ──[static]──► camera
                                               ──[static]──► laser

  Flujo de datos:
    /odom (twist)  ──►┐
    /imu/data      ──►│  ekf_filter_node  ──► /odometry/filtered
                      │                   ──► TF odom→base_link
    /scan          ──►┤
    TF odom→base   ──►│  amcl            ──► /amcl_pose
                      │                   ──► TF map→odom
    /map           ──►┘

  Nodos:
    1. tartanground_node_ekf  — publica sensores del dataset
    2. pcd_map_publisher      — convierte PCD a OccupancyGrid
    3. ekf_filter_node        — robot_localization EKF (odom→base_link)
    4. amcl                   — localización global (map→odom)
    5. amcl_logger            — grabación de resultados
    6. lifecycle_manager      — gestiona ciclo de vida de amcl
    7. rviz2                  — visualización
-->
<launch>

  <!-- ================================================================ -->
  <!--  NODO 1 — TartanGroundNode (modo EKF)                           -->
  <!-- ================================================================ -->
  <node pkg="tartan_to_ros"
        exec="tartanground_node_ekf.py"
        name="tartanground_node"
        output="screen">

    <param name="dataset_path"
           value="/home/israelnunez/tartanairpy/Office/Data_omni/P0000"/>

    <param name="topic_rgb_image"    value="/camera/rgb"/>
    <param name="topic_depth_image"  value="/camera/depth"/>
    <param name="topic_camera_info"  value="/camera/camera_info"/>
    <param name="topic_localization" value="/gt/robot_pose"/>

    <param name="map_frame_id"    value="map"/>
    <param name="robot_frame_id"  value="base_link"/>
    <param name="camera_frame_id" value="camera"/>
    <param name="lidar_frame_id"  value="laser"/>

    <param name="publish_rate" value="10.0"/>

    <param name="img_width"  value="640"/>
    <param name="img_height" value="640"/>
    <param name="fx" value="320.0"/>
    <param name="fy" value="320.0"/>
    <param name="cx" value="320.0"/>
    <param name="cy" value="320.0"/>

    <param name="use_sim_time" value="true"/>
  </node>

  <!-- ================================================================ -->
  <!--  NODO 2 — PcdMapPublisher                                        -->
  <!-- ================================================================ -->
  <node pkg="tartan_to_ros"
        exec="map_tartanground.py"
        name="pcd_map_publisher"
        output="screen">

    <param name="pcd_path"
           value="/home/israelnunez/tartanairpy/Office/Office_rgb.pcd"/>
    <param name="topic_map"    value="/map"/>
    <param name="map_frame_id" value="map"/>
    <param name="resolution"   value="0.05"/>
    <param name="z_min"        value="-0.5"/>
    <param name="z_max"        value="3.0"/>
    <param name="padding"      value="0.5"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- ================================================================ -->
  <!--  NODO 3 — EKF (robot_localization)                              -->
  <!--  Publica TF odom → base_link                                    -->
  <!--  Fusiona /odom (twist) + /imu/data (wz)                         -->
  <!-- ================================================================ -->
  <node pkg="robot_localization"
        exec="ekf_node"
        name="ekf_filter_node"
        output="screen"
        respawn="true"
        launch-prefix="bash -c 'sleep 5; $0 $@'">

    <!--
      Carga la configuración completa desde YAML.
      Ajusta la ruta si el paquete está en otro workspace.
    -->
    <param from="$(find-pkg-share tartan_to_ros)/config/ekf_tartanground.yaml"/>

    <param name="use_sim_time" value="true"/>
  </node>

  <!-- ================================================================ -->
  <!--  NODO 4 — AMCL                                                   -->
  <!--  Publica TF map → odom                                           -->
  <!-- ================================================================ -->
  <node pkg="nav2_amcl"
        exec="amcl"
        name="amcl"
        output="screen"
        launch-prefix="bash -c 'sleep 8; $0 $@'">

    <param name="use_sim_time" value="true"/>

    <!-- Frames -->
    <param name="base_frame_id"   value="base_link"/>
    <param name="odom_frame_id"   value="odom"/>
    <param name="global_frame_id" value="map"/>

    <!-- Scan -->
    <param name="scan_topic" value="/scan"/>

    <!-- Pose inicial desde /initialpose (publicada por el nodo del dataset) -->
    <param name="set_initial_pose" value="true"/>

    <!-- ─── Partículas ────────────────────────────────────────────────────
         Con EKF la odometría es suave → AMCL necesita menos partículas
         para mantener buena localización                                  -->
    <param name="min_particles" value="500"/>
    <param name="max_particles" value="2000"/>
    <param name="kld_err"       value="0.05"/>
    <param name="kld_z"         value="0.99"/>

    <!-- ─── Cuándo actualizar ────────────────────────────────────────────
         Con EKF el movimiento es más preciso → umbrales bajos            -->
    <param name="update_min_d"      value="0.05"/>
    <param name="update_min_a"      value="0.05"/>
    <param name="resample_interval" value="2"/>

    <!-- ─── Tolerancia TF ────────────────────────────────────────────────
         1.0 s para cubrir el desfase IMU (100Hz) / cámara (10Hz)        -->
    <param name="transform_tolerance" value="1.0"/>
    <param name="tf_broadcast"        value="true"/>

    <!-- ─── Modelo de láser (likelihood_field) ──────────────────────────
         Pesos deben sumar exactamente 1.0:
           z_hit=0.75 + z_short=0.05 + z_max=0.05 + z_rand=0.15 = 1.00  -->
    <param name="laser_model_type"          value="likelihood_field"/>
    <param name="laser_max_beams"           value="120"/>
    <param name="laser_max_range"           value="20.0"/>
    <param name="laser_min_range"           value="0.1"/>
    <param name="sigma_hit"                 value="0.35"/>
    <param name="z_hit"                     value="0.75"/>
    <param name="z_short"                   value="0.05"/>
    <param name="z_max"                     value="0.05"/>
    <param name="z_rand"                    value="0.15"/>
    <param name="lambda_short"              value="0.1"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>

    <param name="do_beamskip"               value="true"/>
    <param name="beam_skip_distance"        value="0.5"/>
    <param name="beam_skip_threshold"       value="0.3"/>
    <param name="beam_skip_error_threshold" value="0.9"/>

    <!-- ─── Modelo de odometría ──────────────────────────────────────────
         OmniMotionModel: adecuado para TartanGround (vy no nulo).
         Alphas bajos porque el EKF ya filtra el ruido de odometría:
           alpha1/2: ruido rotacional pequeño (EKF estabiliza el yaw)
           alpha3/4: ruido translacional pequeño (EKF estabiliza vx,vy)
           alpha5:   término de strafe para modelo omnidireccional        -->
    <param name="robot_model_type" value="nav2_amcl::OmniMotionModel"/>
    <param name="alpha1" value="0.02"/>
    <param name="alpha2" value="0.02"/>
    <param name="alpha3" value="0.01"/>
    <param name="alpha4" value="0.01"/>
    <param name="alpha5" value="0.01"/>

    <!-- ─── Recovery DESACTIVADO ─────────────────────────────────────────
         Con EKF la odometría es continua y suave → no hay pérdidas
         repentinas que disparen la inyección de partículas aleatorias.
         recovery_alpha_fast > 0 causa grandes saltos de pose.           -->
    <param name="recovery_alpha_slow" value="0.0"/>
    <param name="recovery_alpha_fast" value="0.0"/>

    <param name="save_pose_rate" value="0.5"/>
  </node>

  <!-- ================================================================ -->
  <!--  NODO 5 — Logger AMCL                                            -->
  <!-- ================================================================ -->
  <!-- <node pkg="tartan_to_ros"
        exec="amcl_logger.py"
        name="amcl_logger"
        output="screen">
    <param name="use_sim_time" value="true"/>
  </node> -->

  <!-- ================================================================ -->
  <!--  NODO 6 — Lifecycle Manager                                      -->
  <!--  Gestiona sólo AMCL (EKF no es lifecycle node)                  -->
  <!-- ================================================================ -->
  <node pkg="nav2_lifecycle_manager"
        exec="lifecycle_manager"
        name="lifecycle_manager_localization"
        output="screen">

    <param name="use_sim_time" value="true"/>
    <param name="autostart"    value="true"/>
    <param name="node_names"   value="['amcl']"/>
    <param name="bond_timeout" value="4.0"/>
  </node>

  <!-- ================================================================ -->
  <!--  NODO 7 — RViz2                                                  -->
  <!-- ================================================================ -->
  <node pkg="rviz2"
        exec="rviz2"
        name="rviz2"
        args="-d src/tartan_to_ros/rviz/TartanGroundRVIZ.rviz"
        output="screen">
    <param name="use_sim_time" value="true"/>
  </node>

</launch>
