<?xml version="1.0"?>
<!--
  tartanground_amcl.launch.xml — TartanGround + AMCL mejorado
  Correcciones respecto a la versión anterior:
    [L1] use_sim_time consistente en TODOS los nodos (true)
    [L2] lifecycle_manager también con use_sim_time=true
    [L3] AMCL: set_initial_pose=true para que lea /initialpose
    [L4] update_min_d / update_min_a reducidos (0.1 / 0.05)
    [L5] Modelo de láser likelihood_field bien parametrizado
    [L6] Modelo de odometría diff con alphas realistas
    [L7] Más partículas y recovery habilitado
    [L8] XML válido (texto suelto eliminado)
-->
<launch>

  <!-- ================================================================ -->
  <!--  NODO 1 — TartanGroundNode                                       -->
  <!-- ================================================================ -->
  <node pkg="tartan_to_ros"
        exec="tartanground_node_fixed2.py"
        name="tartanground_node"
        output="screen">

    <!-- Dataset -->
    <param name="dataset_path"
           value="/home/israelnunez/tartanairpy/Office/Data_omni/P0000"/>

    <!-- Tópicos -->
    <param name="topic_rgb_image"    value="/camera/rgb"/>
    <param name="topic_depth_image"  value="/camera/depth"/>
    <param name="topic_camera_info"  value="/camera/camera_info"/>
    <param name="topic_localization_gt" value="/gt/robot_pose"/>

    <!-- Frames -->
    <param name="map_frame_id"    value="map"/>
    <param name="robot_frame_id"  value="base_link"/>
    <param name="camera_frame_id" value="camera"/>
    <param name="lidar_frame_id"  value="laser"/>

    <!-- Frecuencia -->
    <param name="publish_rate" value="10.0"/>

    <!-- Intrínsecas cámara (TartanGround) -->
    <param name="img_width"  value="640"/>
    <param name="img_height" value="640"/>
    <param name="fx" value="320.0"/>
    <param name="fy" value="320.0"/>
    <param name="cx" value="320.0"/>
    <param name="cy" value="320.0"/>

    <!-- [L1] Tiempo simulado -->
    <param name="use_sim_time" value="true"/>

  </node>

  <!-- ================================================================ -->
  <!--  NODO 2 — PcdMapPublisher                                        -->
  <!-- ================================================================ -->
  <node pkg="tartan_to_ros"
        exec="map_tartanground.py"
        name="pcd_map_publisher"
        output="screen">

    <param name="pcd_path"
           value="/home/israelnunez/tartanairpy/Office/Office_rgb.pcd"/>
    <param name="topic_map"    value="/map"/>
    <param name="map_frame_id" value="map"/>
    <param name="resolution"   value="0.05"/>
    <param name="z_min"        value="-0.5"/>
    <param name="z_max"        value="3.0"/>
    <param name="padding"      value="0.5"/>
    <param name="use_sim_time" value="true"/>

  </node>

  <!-- ================================================================ -->
  <!--  NODO 3 — AMCL                                                   -->
  <!-- ================================================================ -->
  <node pkg="nav2_amcl"
        exec="amcl"
        name="amcl"
        output="screen">

    <!-- [L1] Tiempo simulado -->
    <param name="use_sim_time" value="true"/>

    <!-- Frames -->
    <param name="base_frame_id"   value="base_link"/>
    <param name="odom_frame_id"   value="odom"/>
    <param name="global_frame_id" value="map"/>

    <!-- Tópicos -->
    <param name="scan_topic" value="/scan"/>

    <!-- ─── Pose inicial ───────────────────────────────────────────── -->
    <!-- [L3] Con set_initial_pose=true AMCL lee /initialpose al arrancar -->
    <param name="set_initial_pose" value="true"/>

    <!-- ─── Partículas ────────────────────────────────────────────── -->
    <!-- [L7] Más partículas para mejor cobertura del espacio de estados -->
    <param name="min_particles" value="6000"/>
    <param name="max_particles" value="8000"/>

    <!-- KLD sampling -->
    <param name="kld_err" value="0.05"/>
    <param name="kld_z"   value="0.99"/>

    <!-- ─── Cuándo actualizar ─────────────────────────────────────── -->
    <!-- [L4] Valores bajos → actualiza frecuentemente               -->
    <param name="update_min_d" value="0.05"/>
    <param name="update_min_a" value="0.05"/>
    <param name="resample_interval" value="1"/>

    <!-- ─── Tolerancia TF ─────────────────────────────────────────── -->
    <param name="transform_tolerance" value="0.5"/>
    <param name="tf_broadcast"        value="true"/>

    <!-- ─── Modelo de láser (likelihood_field) ───────────────────── -->
    <!-- [L5] Parámetros del modelo de medida correctamente tuneados  -->
    <param name="laser_model_type"          value="likelihood_field"/>
    <param name="laser_max_beams"           value="60"/>
    <!-- Reducir beams acelera AMCL sin perder precisión significativa  -->
    <param name="laser_max_range"           value="20.0"/>
    <param name="laser_min_range"           value="0.1"/>
    <!-- sigma_hit: desv. estándar del modelo gaussiano de impactos   -->
    <param name="sigma_hit"                 value="0.2"/>
    <!-- Mezcla de modelos: impactos, aleatoriedad, máximo rango       -->
    <param name="z_hit"                     value="0.8"/>
    <param name="z_short"                   value="0.05"/>
    <param name="z_max"                     value="0.05"/>
    <param name="z_rand"                    value="0.2"/>
    <param name="lambda_short"              value="0.1"/>
    <!-- Radio de búsqueda del mapa de distancias para likelihood_field -->
    <param name="laser_likelihood_max_dist" value="2.0"/>

    <!-- Beam skip: ignora hasta 30 % de rayos aberrantes             -->
    <param name="do_beamskip"               value="true"/>
    <param name="beam_skip_distance"        value="0.5"/>
    <param name="beam_skip_threshold"       value="0.2"/>
    <param name="beam_skip_error_threshold" value="0.9"/>

    <!-- ─── Modelo de odometría ──────────────────────────────────── -->
    <!-- [L6] diff-corrected con alphas adaptados a un robot simulado  -->
    <!--   alpha1: ruido rotación ← movimiento rotacional              -->
    <!--   alpha2: ruido rotación ← movimiento translacional           -->
    <!--   alpha3: ruido translación ← movimiento translacional        -->
    <!--   alpha4: ruido translación ← movimiento rotacional           -->
    <param name="robot_model_type" value="nav2_amcl::OmniMotionModel"/> # nav2_amcl::OmniMotionModel / DifferentialMotionModel
    <param name="alpha1" value="0.05"/>
    <param name="alpha2" value="0.05"/>
    <param name="alpha3" value="0.02"/>
    <param name="alpha4" value="0.02"/>
    <param name="alpha" value="0.02"/>

    <!-- ─── Recovery (globalización parcial ante pérdida) ────────── -->
    <!-- [L7] Inyecta partículas aleatorias si la probabilidad cae    -->
    <param name="recovery_alpha_slow" value="0.001"/>
    <param name="recovery_alpha_fast" value="0.1"/>

    <!-- Tiempo máximo sin recibir mapa/scan antes de fallar          -->
    <param name="save_pose_rate" value="0.5"/>

  </node>

  <node pkg="tartan_to_ros"
        exec="amcl_logger.py"
        name="amcl_logger"
        output="screen">

        </node>

  <!-- ================================================================ -->
  <!--  NODO 4 — Lifecycle Manager                                      -->
  <!-- ================================================================ -->
  <node pkg="nav2_lifecycle_manager"
        exec="lifecycle_manager"
        name="lifecycle_manager_localization"
        output="screen">

    <!-- [L2] DEBE coincidir con use_sim_time de AMCL                 -->
    <param name="use_sim_time" value="true"/>
    <param name="autostart"    value="true"/>
    <param name="node_names"   value="['amcl']"/>

    <!-- Tiempo de espera al activar los nodos (en segundos)          -->
    <param name="bond_timeout" value="4.0"/>

  </node>

  <!-- ================================================================ -->
  <!--  NODO 5 — RViz2                                                  -->
  <!-- ================================================================ -->
  <node pkg="rviz2"
        exec="rviz2"
        name="rviz2"
        args="-d src/tartan_to_ros/rviz/TartanGroundRVIZ.rviz"
        output="screen">
    <param name="use_sim_time" value="true"/>
  </node>




</launch>