<?xml version="1.0"?>
<launch>

  <!-- ================================================================ -->
  <!--  NODO 1 — TartanGroundNode                                       -->
  <!-- ================================================================ -->
  <node pkg="tartan_to_ros"
        exec="tartanground_node_fixed3.py"
        name="tartanground_node"
        output="screen">

    <!-- Dataset -->
    <param name="dataset_path"
           value="/home/israelnunez/tartanairpy/Office/Data_omni/P0000"/>

    <!-- Tópicos -->
    <param name="topic_rgb_image"    value="/camera/rgb"/>
    <param name="topic_depth_image"  value="/camera/depth"/>
    <param name="topic_camera_info"  value="/camera/camera_info"/>
    <param name="topic_localization" value="/gt/robot_pose"/>

    <!-- Frames -->
    <param name="map_frame_id"    value="map"/>
    <param name="robot_frame_id"  value="base_link"/>
    <param name="camera_frame_id" value="camera"/>
    <param name="lidar_frame_id"  value="laser"/>

    <!-- Frecuencia de publicación (Hz) -->
    <param name="publish_rate" value="10.0"/>

    <!-- Intrínsecas cámara TartanGround (f = 320 px, cx=cy=320) -->
    <param name="img_width"  value="640"/>
    <param name="img_height" value="640"/>
    <param name="fx" value="320.0"/>
    <param name="fy" value="320.0"/>
    <param name="cx" value="320.0"/>
    <param name="cy" value="320.0"/>

    <!-- [L1] Tiempo simulado -->
    <param name="use_sim_time" value="true"/>

  </node>

  <!-- ================================================================ -->
  <!--  NODO 2 — PcdMapPublisher                                        -->
  <!-- ================================================================ -->
  <node pkg="tartan_to_ros"
        exec="map_tartanground.py"
        name="pcd_map_publisher"
        output="screen">

    <param name="pcd_path"
           value="/home/israelnunez/tartanairpy/Office/Office_rgb.pcd"/>
    <param name="topic_map"    value="/map"/>
    <param name="map_frame_id" value="map"/>
    <param name="resolution"   value="0.05"/>
    <param name="z_min"        value="-0.5"/>
    <param name="z_max"        value="3.0"/>
    <param name="padding"      value="0.5"/>

    <!-- [L1] Tiempo simulado -->
    <param name="use_sim_time" value="true"/>

  </node>

  <!-- ================================================================ -->
  <!--  NODO 3 — AMCL                                                   -->
  <!-- ================================================================ -->
  <node pkg="nav2_amcl" exec="amcl" name="amcl" output="screen">
    
    <!--Partículas --> 
    <param name="min_particles" value="500"/>
    <param name="max_particles" value="5000"/>

    <param name="robot_model_type" value="nav2_amcl::OmniMotionModel"/>
    <param name="base_frame_id" value="base_link"/>
    <!-- - Motion model -->
    <param name="alpha1" value="0.2"/>
    <param name="alpha2" value="0.2"/>
    <param name="alpha3" value="0.2"/>
    <param name="alpha4" value="0.2"/>
    <param name="alpha5" value="0.1"/>

    <!--  Sensor model -->
    <param name="laser_model_type" value="likelihood_field"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>
    <param name="z_hit" value="0.5"/>
    <param name="z_rand" value="0.5"/>
    <param name="sigma_hit" value="0.2"/>

    <!-- - Recovery desactivado - -->
    <param name="recovery_alpha_slow" value="0.0"/>
    <param name="recovery_alpha_fast" value="0.0"/>

    <!-- - TF - -->
    <param name="tf_broadcast" value="true"/>
    <param name="transform_tolerance" value="0.5"/>

    <!-- - Update motion - -->
    <param name="update_min_d" value="0.2"/>
    <param name="update_min_a" value="0.5"/>

    <!--- Resampling - -->
    <param name="resample_interval" value="2"/>
  
  </node>

  <!-- ================================================================ -->
  <!--  NODO 4 — Logger AMCL                                            -->
  <!-- ================================================================ -->
  <node pkg="tartan_to_ros"
        exec="amcl_logger.py"
        name="amcl_logger"
        output="screen">
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- ================================================================ -->
  <!--  NODO 5 — Lifecycle Manager                                      -->
  <!-- ================================================================ -->
  <node pkg="nav2_lifecycle_manager"
        exec="lifecycle_manager"
        name="lifecycle_manager_localization"
        output="screen">

    <!-- [L2] DEBE coincidir con use_sim_time de AMCL -->
    <param name="use_sim_time" value="true"/>
    <param name="autostart"    value="true"/>
    <param name="node_names"   value="['amcl']"/>

    <!-- Tiempo de espera al activar los nodos (segundos) -->
    <param name="bond_timeout" value="4.0"/>

  </node>

  <!-- ================================================================ -->
  <!--  NODO 6 — RViz2                                                  -->
  <!-- ================================================================ -->
  <node pkg="rviz2"
        exec="rviz2"
        name="rviz2"
        args="-d src/tartan_to_ros/rviz/TartanGroundRVIZ.rviz"
        output="screen">
    <param name="use_sim_time" value="true"/>
  </node>

</launch>
