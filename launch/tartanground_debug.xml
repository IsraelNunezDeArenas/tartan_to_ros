<launch>

  <node pkg="tartan_to_ros"
        exec="tartanground_debug.py"
        name="tartanground_debug"
        output="screen"/>

  <!-- <node pkg="tartan_to_ros"
        exec="map_tartanground_CC.py"
        name="pcd_map_publisher"
        output="screen">
    <param name="pcd_path" value="/home/israel/tartanairpy/Office/Office_rgb.pcd"/>
    <param name="topic_map" value="/map"/>
    <param name="map_frame_id" value="map"/>
    <param name="resolution" value="0.05"/>
    <param name="z_min" value="-0.3"/>
    <param name="z_max" value="1.0"/>
    <param name="padding" value="0.5"/>
    <param name="use_sim_time" value="true"/>
  </node> -->

  <node pkg="nav2_amcl"
        exec="amcl"
        name="amcl"
        output="screen"
        >

    <param name="use_sim_time" value="true"/>

    <!-- Frames -->
    <param name="base_frame_id"   value="base_link"/>
    <param name="odom_frame_id"   value="odom"/>
    <param name="global_frame_id" value="map"/>

    <!-- Scan -->
    <param name="scan_topic" value="/scan"/>

    <!-- Pose inicial desde /initialpose (publicada por el nodo del dataset) -->
    <param name="set_initial_pose" value="true"/>

    <!-- ─── Partículas ────────────────────────────────────────────────────
         Con EKF la odometría es suave → AMCL necesita menos partículas
         para mantener buena localización                                  -->
    <param name="min_particles" value="500"/>
    <param name="max_particles" value="2000"/>
    <param name="kld_err"       value="0.05"/>
    <param name="kld_z"         value="0.99"/>

    <!-- ─── Cuándo actualizar ────────────────────────────────────────────
         Con EKF el movimiento es más preciso → umbrales bajos            -->
    <param name="update_min_d"      value="0.05"/>
    <param name="update_min_a"      value="0.05"/>
    <param name="resample_interval" value="2"/>

    <!-- ─── Tolerancia TF ────────────────────────────────────────────────
         1.0 s para cubrir el desfase IMU (100Hz) / cámara (10Hz)        -->
    <param name="transform_tolerance" value="1.0"/>
    <param name="tf_broadcast"        value="true"/>
    <param name="laser_model_type"          value="likelihood_field"/>
    <param name="laser_max_beams"           value="120"/>
    <param name="laser_max_range"           value="20.0"/>
    <param name="laser_min_range"           value="0.1"/>
    <param name="sigma_hit"                 value="0.35"/>
    <param name="z_hit"                     value="0.75"/>
    <param name="z_short"                   value="0.05"/>
    <param name="z_max"                     value="0.05"/>
    <param name="z_rand"                    value="0.15"/>
    <param name="lambda_short"              value="0.1"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>

    <param name="do_beamskip"               value="true"/>
    <param name="beam_skip_distance"        value="0.5"/>
    <param name="beam_skip_threshold"       value="0.3"/>
    <param name="beam_skip_error_threshold" value="0.9"/>
    <param name="robot_model_type" value="nav2_amcl::OmniMotionModel"/>
    <param name="alpha1" value="0.02"/>
    <param name="alpha2" value="0.02"/>
    <param name="alpha3" value="0.01"/>
    <param name="alpha4" value="0.01"/>
    <param name="alpha5" value="0.01"/>
    <param name="recovery_alpha_slow" value="0.0"/>
    <param name="recovery_alpha_fast" value="0.0"/>

    <param name="save_pose_rate" value="0.5"/>
  </node>


  <node pkg="nav2_lifecycle_manager"
        exec="lifecycle_manager"
        name="lifecycle_manager_localization"
        output="screen">

    <param name="use_sim_time" value="true"/>
    <param name="autostart"    value="true"/>
    <param name="node_names"   value="['amcl']"/>
    <param name="bond_timeout" value="4.0"/>
  </node>

 
<node pkg="robot_localization"
      exec="ekf_node"
      name="ekf_filter_node"
      output="screen"
      args="--ros-args --params-file src/tartan_to_ros/config/ekf_debug.yaml">

       <param name="use_sim_time" value="true"/>

    <!--
      Carga la configuración completa desde YAML.
      Ajusta la ruta si el paquete está en otro workspace.
    -->
     <param name="use_sim_time" value="true"/>

  </node>


  <node pkg="rviz2"
        exec="rviz2"
        name="rviz2"
        args="-d src/tartan_to_ros/rviz/Debug.rviz"
        output="screen">

        <param name="use_sim_time" value="true"/>
  </node>

</launch>