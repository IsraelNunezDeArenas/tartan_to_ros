<launch>

    <node pkg="tartan_to_ros"
        exec="tartanground_debug.py"
        name="tartanground_debug"
        output="screen"
        launch-prefix="bash -c 'sleep 1; exec $0 $@'">    <!-- Time delay -->

        <param name="dataset_path" value="/home/ubuntu/Office/Data_omni/P0000"/>    <!-- Trajectory path -->
        <param name="publish_rate" value="10.0"/>                                   <!-- Frecuency -->
        <param name="loop" value="false"/>                                          <!-- Start once the rep. has finisehd-->

        <param name="world_frame" value="map"/>
        <param name="robot_frame" value="base_link"/>
        <param name="robot_frame_GT" value="base_link_GT"/>

        <param name="camera_frame" value="camera"/>
        <param name="camera_frame_GT" value="camera_GT"/>

        <param name="camera_file" value="pose_lcam_front.txt"/>                 <!-- Camera used for the images (left front default)-->

        <param name="lidar_frame" value="lidar"/>
        <param name="lidar_frame_GT" value="lidar_GT"/>

        <param name="robot_file" value="pose_body.txt"/>

        <param name="topic_image_rgb" value="/camera/rgb"/>                     <!-- Image topic - RGB image from camera-->
        <param name="topic_image_depth" value="/camera/depth"/>                 <!-- Image topic - Depth image from camera-->
        <param name="topic_pose" value="/pose_gt"/>                             <!-- Image topic - Depth image from camera-->

        <param name="end_frame" value="4170"/>                                  <!-- End Frame -->
        <param name="start_frame" value="3700"/>                                <!-- Start Frame -->
        <param name="use_gt" value="False"/>                                    <!-- use_gt: True for pose, images, lidar -->
                                                                                <!-- use_gt: False for imu, odom, pose, images, lidar -->

        <param name="time_wait" value="False"/>                                 <!-- time_wait: True in order to wait  -->
                                                                                <!-- to map_tartanground to publish map-->
 
    </node>

    <node pkg="tartan_to_ros"
        exec="odom_to_pose.py"
        name="odom_to_pose"
        output="screen">

        <param name="use_sim_time" value="true"/>

    </node>

    <node pkg="robot_localization"
      exec="ekf_node"
      name="ekf_filter_node"
      output="screen"
      respawn="true">
        <param from="$(find-pkg-share tartan_to_ros)/config/ekf_tartanground.yaml"/>

    </node>

</launch>